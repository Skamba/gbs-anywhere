{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "PowerShell(cargo build *)",
      "PowerShell(cargo check *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(cargo fmt *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git tag *)",
      "PowerShell(git tag *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh release *)",
      "PowerShell(gh release *)",
      "Edit(/.github/workflows/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cargo",
            "args": ["fmt", "--all", "--quiet"]
          }
        ]
      }
    ]
  }
}
